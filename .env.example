# UniGuide AI - Environment Variables Example
# Copy this file to .env and fill in your actual values

# Database Credentials
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://localhost:3306/uniguide_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC

# AI & API Services
GEMINI_API_KEY=your_gemini_api_key_here
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5500

# Security Secret
JWT_SECRET=your_jwt_secret_here_use_a_long_random_hex_string
